{
    "name": "drupalwxt/wxt",
    "description": "Project template for Drupal 10 sites built with the WxT distribution.",
    "type": "drupal-profile",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "ext-dom": "*",
        "bower-asset/cropper": "^2.3",
        "bower-asset/slick-carousel": "^1.8",
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.5",
        "drupal/autosave_form": "^1.7",
        "drupal/block_class": "^4.0",
        "drupal/blog": "^3.1",
        "drupal/book": "^2.0",
        "drupal/bootstrap_layouts": "^5.4",
        "drupal/button_link": "2.0.x-dev@dev",
        "drupal/ckeditor_abbreviation": "^5.0",
        "drupal/ckeditor_codemirror": "^3.1",
        "drupal/ckeditor_details": "^2.1@beta",
        "drupal/config_rewrite": "^1.6",
        "drupal/core-composer-scaffold": "11.1.*",
        "drupal/core-recommended": "11.1.*",
        "drupal/core_context": "1.x-dev@dev",
        "drupal/crop": "^2.4",
        "drupal/ctools": "^4.1",
        "drupal/diff": "^1.8",
        "drupal/dropzonejs": "^2.11",
        "drupaloverride/embed": "dev-master",
        "drupal/entity_block": "2.0.x-dev@dev",
        "drupal/entity_browser": "^2.12",
        "drupaloverride/entity_browser_block": "dev-master",
        "drupaloverride/entity_embed": "dev-master",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/entityqueue": "^1.9",
        "drupal/field_formatter": "^3.0",
        "drupal/field_group": "^3.6",
        "drupal/file_entity": "^2.1",
        "drupaloverride/fontawesome": "dev-master",
        "drupal/footnotes": "^4.0@beta",
        "drupal/fakeobjects": "1.x-dev@dev",
        "drupal/flexible_permissions": "^2.0.1",
        "drupal/group": "^2.3",
        "drupal/image_widget_crop": "2.x-dev@dev",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupaloverride/layout_builder_st": "dev-master",
        "drupal/layout_builder_styles": "^2.1",
        "drupal/layout_library": "^1.0@beta",
        "drupal/linkit": "^7.0",
        "drupal/media_entity_instagram": "^4.0@beta",
        "drupal/media_entity_twitter": "^2.10",
        "drupal/media_entity_slideshow": "^2.6",
        "drupal/menu_block": "^1.13",
        "drupal/menu_breadcrumb": "^2.0.x-dev@dev",
        "drupal/metatag": "^2.1",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.0",
        "drupal/page_manager": "^4.0@RC",
        "drupal/panels": "4.x-dev@dev",
        "drupal/paragraphs": "^1.18",
        "drupal/password_policy": "^4.0",
        "drupal/pathauto": "^1.13",
        "drupal/redirect": "^1.10",
        "drupal/redis": "^1.8",
        "drupal/search_api": "^1.37",
        "drupal/simple_sitemap": "^4.2",
        "drupal/slick_entityreference": "^3.0",
        "drupaloverride/toc_api": "dev-master",
        "drupal/toc_filter": "^2.3",
        "drupal/token": "^1.15",
        "drupal/token_filter": "^2.2",
        "drupaloverride/url_embed": "dev-master",
        "drupal/video_embed_field": "^3.0@alpha",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_bootstrap": "5.3.*",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.3@alpha",
        "drupalwxt/wxt_bootstrap": "11.1.x-dev",
        "drupalwxt/wxt_library": "11.1.x-dev",
        "cdubz/ckeditor5-source-editing-codemirror": "^35.1",
        "codemirror/codemirror": "^5.65",
        "npm-asset/dropzone": "^5.7.4",
        "phpdocumentor/reflection-docblock": "^5",
        "vardot/blazy": "^1.8",
        "w8tcha/ckeditor-codemirror": "1.18.5"
    },
    "require-dev": {
        "drupal/core-dev": "11.1.*",
        "drupal/drupal-extension": "5.0.0-alpha1",
        "drush/drush": "^13.3.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "squizlabs/php_codesniffer": "3.*",
        "phpspec/prophecy-phpunit": "^2"
    },
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "Drupal\\wxt\\": "src"
        },
        "classmap": []
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/embed-3430097.git",
                    "type": "git",
                    "reference": "3430097-automated-drupal-11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/url_embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/url_embed-3438709.git",
                    "type": "git",
                    "reference": "composer-workaround-d11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/entity_browser_block",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/entity_browser_block-3430130.git",
                    "type": "git",
                    "reference": "project-update-bot-only"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/entity_embed",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/entity_embed-3430164.git",
                    "type": "git",
                    "reference": "3430164-d11-readiness"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/fontawesome",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/fontawesome-3465765.git",
                    "type": "git",
                    "reference": "3465765-drupal-11-compatibility"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/layout_builder_st",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/layout_builder_st-3431600.git",
                    "type": "git",
                    "reference": "3431600-automated-drupal-11"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "drupaloverride/toc_api",
                "version": "dev-master",
                "type": "drupal-module",
                "source": {
                    "url": "https://git.drupalcode.org/issue/toc_api-3455312.git",
                    "type": "git",
                    "reference": "3455312-drupal11-fixes"
                }
            }
        }
    ],
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drush": {
            "services": {
                "drush.services.yml": "^10"
            }
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/block_content_permissions": {
                "2920739 - Allow accessing the 'Custom block library' page without 'Administer blocks' permission":
                "https://www.drupal.org/files/issues/2022-07-26/2920739-55.access_listing_page.patch"
            },
            "drupal/core": {
                "Enter drupal/core patch #850600 description here":
                "https://www.drupal.org/files/issues/2024-08-19/postgresql-ssl-dns-850600-38.patch",
                "Enter drupal/core patch #2630732 description here":
                "https://www.drupal.org/files/issues/2024-12-18/entity-fields-migration-destination-10.4.x-2630732-169.patch",
                "Enter drupal/core patch #2752443 description here":
                "https://www.drupal.org/files/issues/in_correct_order_and-2752443-1.patch",
                "Enter drupal/core patch #2816921 description here":
                "https://www.drupal.org/files/issues/user_password-2816921-2.patch",
                "Enter drupal/core patch #2857273 description here":
                "https://www.drupal.org/files/issues/2020-07-13/D91x-self_closing_correct-2857273-13.patch",
                "Enter drupal/core patch #2885370 description here":
                "https://www.drupal.org/files/issues/systemmainblock_build-2885370-3.patch",
                "Enter drupal/core patch #2893029 description here":
                "https://www.drupal.org/files/issues/2893029-9.patch",
                "3016131 - Improved exception message developer experience":
                "https://www.drupal.org/files/issues/2020-05-26/drupal-3016131-23-useless-exception.patch",
                "3107212 - views no results behavior on field level is not translateable":
                "https://www.drupal.org/files/issues/2023-01-23/d10-1-x--3107212-19.patch",
                "3359497 - Prevent warnings when library definitions have a license with no URL defined, contrib is not perfect here.":
                "https://www.drupal.org/files/issues/2023-10-07/fix-license-missing-url.patch"
            },
            "drupal/ctools": {
                "Enter drupal/ctools patch #2667652 description here":
                "https://www.drupal.org/files/issues/ctools-option_to_expose-2667652-3.patch",
                "Enter drupal/ctools patch #2924356 description here":
                "https://www.drupal.org/files/issues/2024-06-14/ctools-entity_field_rendered_twice-2924356-12.patch"
            },
            "drupal/diff": {
                "Enter drupal/diff patch #2844337 description here":
                "https://www.drupal.org/files/issues/2024-04-15/2844337-array_to_string_conversion-29.patch",
                "Enter drupal/diff patch #2834253 description here":
                "https://www.drupal.org/files/issues/2024-05-09/diff-missing_column_headers-2834253-23.patch",
                "Enter drupal/diff patch #2882334 description here":
                "https://www.drupal.org/files/issues/2020-09-28/2882334-diff-missing_some_revisions-13.patch",
                "Enter drupal/diff patch #3004705 description here":
                "https://git.drupalcode.org/project/diff/-/merge_requests/87.patch",
                "Enter drupal/diff patch #3169729 description here":
                "https://www.drupal.org/files/issues/2020-09-08/diff_add-local-tasks-3169729-2.patch",
                "Enter drupal/diff patch #3228798 description here":
                "https://www.drupal.org/files/issues/2024-05-14/diff-3228798-17.patch"
            },
            "drupal/entity_embed": {
                "3481413 - Fix PHP error":
                "https://www.drupal.org/files/issues/2024-10-17/entity_embed-3481413.patch"
            },
            "drupal/entity_browser": {
                "2914385 - Fix PHP error":
                "https://www.drupal.org/files/issues/2023-10-10/2914385-25.patch"
            },
            "drupal/fontawesome": {
                "3071758 - Fix multiple icons issue":
                "https://git.drupalcode.org/project/fontawesome/-/merge_requests/4.diff"
            },
            "drupal/group": {
                "Enter drupal/group patch #2817109 description here":
                "https://www.drupal.org/files/issues/2022-11-02/2817109-2.0.x-how-to-redirect-30.patch"
            },
            "drupal/layout_builder_st": {
                "3420063 - Call to a member function getConfig() OverridesSectionStorage.php":
                "https://git.drupalcode.org/project/layout_builder_st/-/merge_requests/6.diff",
                "3411037 - Fix core removing contextual translation links":
                "https://git.drupalcode.org/project/layout_builder_st/-/merge_requests/5.patch"
            },
            "drupal/page_manager": {
                "Enter drupal/page_manager patch #2626090 description here":
                "https://www.drupal.org/files/issues/page-manager-2626090-page-title-empty-5.patch",
                "Enter drupal/page_manager patch #3096408 description here":
                "https://www.drupal.org/files/issues/2019-11-23/Issue-3096408-Page-Manager-issue-with-conflict-modul.patch",
                "Enter drupal/page_manager patch #2752227 description here":
                "https://www.drupal.org/files/issues/2024-08-22/2752227-50.patch"
            },
            "drupal/paragraphs": {
                "Enter drupal/paragraphs patch #2878615 description here":
                "https://www.drupal.org/files/issues/comments_entity_uri-2878615-6.patch"
            },
            "drupal/panels": {
                "Enter drupal/panels patch #2910704 description here":
                "https://www.drupal.org/files/issues/panels-ipe-card-flip-ie-error-2910704.diff"
            },
            "drupal/redis": {
                "3004561 - Enable ssl scheme":
                "https://www.drupal.org/files/issues/2021-11-19/redis-support_tls_on_predis-3004561-37.patch"
            },
            "drupal/webform": {
                "Enter drupal/webform patch #3205860 description here":
                "https://www.drupal.org/files/issues/2021-03-26/webform_clientside_validation-3205860-2.patch"
            },
            "drupal/bootstrap_layouts": {
                "3481450 - Fix Drupal 11 support by removing any use of ContainerAwareTrait and ContainerAwareInterface":
                "https://www.drupal.org/files/issues/2025-01-06/3481450-12.patch"
            },
            "drupal/ckeditor_details": {
                "3244311 - Allow <details> element to be placed without <div>":
                "https://www.drupal.org/files/issues/2024-11-15/3244311-9.patch"
            }
        }
    },
    "scripts": {
        "post-install-cmd": [ ],
        "post-update-cmd": [ ],
        "configure-tarball": "Drupal\\wxt\\Composer\\ConfigureLegacyProject::execute",
        "enable-asset-packagist": "Drupal\\wxt\\Composer\\AssetPackagist::execute",
        "nuke": "rm -r -f html vendor",
        "package": "Drupal\\wxt\\Composer\\Package::execute",
        "verify-patched-constraints": "Drupal\\wxt\\Composer\\PatchedConstraint::execute"
    }
}
