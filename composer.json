{
    "name": "drupalwxt/wxt",
    "description": "Project template for Drupal 10 sites built with the WxT distribution.",
    "type": "drupal-profile",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "ext-dom": "*",
        "bower-asset/cropper": "^2.3",
        "bower-asset/slick-carousel": "^1.8",
        "composer/installers": "^2.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.6",
        "drupal/autosave_form": "^1.10",
        "drupal/block_class": "^4.0",
        "drupal/blog": "^3.1",
        "drupal/book": "^2.0",
        "drupal/bootstrap_layouts": "^5.5",
        "drupal/button_link": "^2.0",
        "drupal/ckeditor_abbreviation": "^5.0",
        "drupal/ckeditor_codemirror": "^3.1",
        "drupal/ckeditor_details": "^2.1@beta",
        "drupal/config_rewrite": "^1.6",
        "drupal/core-composer-scaffold": "11.3.*",
        "drupal/core-recommended": "11.3.*",
        "drupal/core_context": "^1.2",
        "drupal/crop": "^2.4",
        "drupal/ctools": "^4.1",
        "drupal/diff": "^1.9",
        "drupal/dropzonejs": "^2.11",
        "drupal/embed": "^1.10",
        "drupal/entity_block": "^2.0",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_browser_block": "^2.0",
        "drupal/entity_embed": "^1.7",
        "drupal/entity_reference_revisions": "^1.12",
        "drupal/entityqueue": "^1.10",
        "drupal/field_formatter": "^3.0",
        "drupal/field_group": "^4.0",
        "drupal/file_entity": "^2.2",
        "drupal/fontawesome": "^3.0",
        "drupal/footnotes": "^4.0@beta",
        "drupal/fakeobjects": "^2.0",
        "drupal/flexible_permissions": "^2.0",
        "drupal/group": "^3.3",
        "drupal/image_widget_crop": "^3.0",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/layout_builder_st": "dev-2.0.x",
        "drupal/layout_builder_styles": "^2.1",
        "drupal/layout_library": "^1.0@beta",
        "drupal/linkit": "^7.0",
        "drupal/media_entity_instagram": "^4.0",
        "drupal/media_entity_twitter": "^2.11",
        "drupal/media_entity_slideshow": "^2.6",
        "drupal/menu_block": "^1.14",
        "drupal/menu_breadcrumb": "^2.0",
        "drupal/metatag": "^2.2",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/page_manager": "^4.0@RC",
        "drupal/panels": "^4.9",
        "drupal/paragraphs": "^1.21",
        "drupal/password_policy": "^4.0",
        "drupal/pathauto": "^1.14",
        "drupal/redirect": "^1.12",
        "drupal/redis": "^1.11",
        "drupal/search_api": "^1.40",
        "drupal/simple_sitemap": "^4.2",
        "drupal/slick_entityreference": "^3.0",
        "drupal/toc_api": "^2.0",
        "drupal/toc_filter": "^2.4",
        "drupal/token": "^1.16",
        "drupal/token_filter": "^2.2",
        "drupal/url_embed": "^3.0",
        "drupal/video_embed_field": "^3.0@beta",
        "drupal/views_autocomplete_filters": "^2.0",
        "drupal/views_bootstrap": "5.3.*",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.3@beta",
        "drupalwxt/wxt_bootstrap": "^11.3",
        "drupalwxt/wxt_library": "^11.3",
        "cdubz/ckeditor5-source-editing-codemirror": "^35.1",
        "codemirror/codemirror": "^5.65",
        "npm-asset/dropzone": "^5.7.4",
        "phpdocumentor/reflection-docblock": "^5",
        "vardot/blazy": "^1.8",
        "w8tcha/ckeditor-codemirror": "1.18.5",
        "fontawesome/fontawesome": "^6.4"
    },
    "require-dev": {
        "drupal/core-dev": "11.3.*",
        "drupal/drupal-extension": "^5.2",
        "drush/drush": "^13.3.3",
        "oomphinc/composer-installers-extender": "^1.1 || ^2",
        "squizlabs/php_codesniffer": "3.*",
        "phpspec/prophecy-phpunit": "^2"
    },
    "config": {
        "discard-changes": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "Drupal\\wxt\\": "src"
        },
        "classmap": []
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "composer",
            "url": "https://drupalwxt.github.io/composer-extdeps/"
        },
        {
            "type": "package",
            "package": {
                "name": "fontawesome/fontawesome",
                "version": "6.4.2",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "fontawesome"
                },
                "dist": {
                    "url": "https://use.fontawesome.com/releases/v6.4.2/fontawesome-free-6.4.2-web.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "html/"
            }
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "html/core": [
                "type:drupal-core"
            ],
            "html/libraries/{$name}": [
                "type:drupal-console-library",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "html/profiles/{$name}": [
                "type:drupal-profile"
            ],
            "html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drush": {
            "services": {
                "drush.services.yml": "^10"
            }
        },
        "enable-patching": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/block_content_permissions": {
                "2920739 - Allow accessing the 'Custom block library' page without 'Administer blocks' permission":
                "https://www.drupal.org/files/issues/2022-07-26/2920739-55.access_listing_page.patch"
            },
            "drupal/core": {
                "Enter drupal/core patch #850600 description here":
                "https://www.drupal.org/files/issues/2024-08-19/postgresql-ssl-dns-850600-38.patch",
                "Enter drupal/core patch #2752443 description here":
                "https://www.drupal.org/files/issues/in_correct_order_and-2752443-1.patch",
                "Enter drupal/core patch #2816921 description here":
                "https://www.drupal.org/files/issues/user_password-2816921-2.patch",
                "Enter drupal/core patch #2857273 description here":
                "https://www.drupal.org/files/issues/2020-07-13/D91x-self_closing_correct-2857273-13.patch",
                "Enter drupal/core patch #2885370 description here":
                "https://www.drupal.org/files/issues/systemmainblock_build-2885370-3.patch",
                "Enter drupal/core patch #2893029 description here":
                "https://www.drupal.org/files/issues/2893029-9.patch",
                "3016131 - Improved exception message developer experience":
                "https://www.drupal.org/files/issues/2020-05-26/drupal-3016131-23-useless-exception.patch",
                "3107212 - views no results behavior on field level is not translateable":
                "https://www.drupal.org/files/issues/2023-01-23/d10-1-x--3107212-19.patch",
                "3359497 - Prevent warnings when library definitions have a license with no URL defined, contrib is not perfect here.":
                "https://www.drupal.org/files/issues/2023-10-07/fix-license-missing-url.patch",
                "2938129 - PageTitle block is non-functional when not handled directly by BlockPageVariant":
                "https://www.drupal.org/files/issues/2025-01-28/drupal-PageTitle_block-2938129-43.patch",
                "3492837 - TypeError: array_key_exists(): Argument #2 ($array) must be of type array, null given in array_key_exists()":
                "https://www.drupal.org/files/issues/2026-03-02/11.3.x-3492837-9.patch"
            },
            "drupal/ctools": {
                "Enter drupal/ctools patch #2667652 description here":
                "https://www.drupal.org/files/issues/ctools-option_to_expose-2667652-3.patch",
                "Enter drupal/ctools patch #2924356 description here":
                "https://www.drupal.org/files/issues/2024-06-14/ctools-entity_field_rendered_twice-2924356-12.patch"
            },
            "drupal/diff": {
                "Enter drupal/diff patch #2844337 description here":
                "https://www.drupal.org/files/issues/2024-04-15/2844337-array_to_string_conversion-29.patch",
                "Enter drupal/diff patch #2882334 description here":
                "https://www.drupal.org/files/issues/2020-09-28/2882334-diff-missing_some_revisions-13.patch",
                "Enter drupal/diff patch #3004705 description here":
                "https://git.drupalcode.org/project/diff/-/merge_requests/87.patch",
                "Enter drupal/diff patch #3169729 description here":
                "https://www.drupal.org/files/issues/2020-09-08/diff_add-local-tasks-3169729-2.patch",
                "Enter drupal/diff patch #3228798 description here":
                "https://www.drupal.org/files/issues/2024-05-14/diff-3228798-17.patch"
            },
            "drupal/entity_browser": {
                "2843247 - Drupal ajax error of undefined method getFileUri() while selecting newly uploaded image":
                "https://www.drupal.org/files/issues/2025-02-13/entity-browser-2843247-16.patch"
            },
            "drupal/entity_embed": {
                "3531672 - Tooltip fix for embedded entities relating to cke5 updates included in Drupal 11.2.10/11.3.2 ..":
                "https://www.drupal.org/files/issues/2025-12-22/entity_embed.issue-3531672-62.patch",
                "3086162 - Prevent bug of adding img attributes to the parent div.":
                "https://www.drupal.org/files/issues/2020-06-15/entity_embed-remove_image_attributes_from_div-3086162-13_0.patch"
            },
            "drupal/fontawesome": {
                "3274028 - CKEditor 5 compatibility":
                "https://www.drupal.org/files/issues/2026-01-10/fontawesome-cke5-compatibility-3274028-72.patch.patch"
            },
            "drupal/group": {
                "Enter drupal/group patch #2817109 description here":
                "https://www.drupal.org/files/issues/2022-11-02/2817109-2.0.x-how-to-redirect-30.patch"
            },
            "drupal/page_manager": {
                "Enter drupal/page_manager patch #2626090 description here":
                "https://www.drupal.org/files/issues/page-manager-2626090-page-title-empty-5.patch",
                "Enter drupal/page_manager patch #2752227 description here":
                "https://www.drupal.org/files/issues/2025-01-15/2752227-56.patch",
                "Enter drupal/page_manager patch #3536704 description here":
                "https://www.drupal.org/files/issues/2026-03-07/page_manager-php8-4-deprecation-3536704-15.patch"
            },
            "drupal/paragraphs": {
                "Enter drupal/paragraphs patch #2878615 description here":
                "https://www.drupal.org/files/issues/comments_entity_uri-2878615-6.patch"
            },
            "drupal/panels": {
                "Enter drupal/panels patch #2910704 description here":
                "https://www.drupal.org/files/issues/panels-ipe-card-flip-ie-error-2910704.diff",
                "Enter drupal/panels patch #3577740 description here":
                "https://www.drupal.org/files/issues/2026-03-07/panels-php8-4-deprecations-3577740-2.patch"
            },
            "drupal/redis": {
                "3004561 - Enable ssl scheme":
                "https://www.drupal.org/files/issues/2025-08-13/redis-support_tls_on_predis-3004561-49.patch"
            },
            "drupal/webform": {
                "Enter drupal/webform patch #3205860 description here":
                "https://www.drupal.org/files/issues/2021-03-26/webform_clientside_validation-3205860-2.patch"
            },
            "drupal/ckeditor_details": {
                "3244311 - Allow <details> element to be placed without <div>":
                "https://www.drupal.org/files/issues/2024-11-15/3244311-9.patch"
            },
            "drupal/layout_builder_st": {
                "3566683 - Fix for WSOD on /admin/reports/status page":
                "https://www.drupal.org/files/issues/2026-01-09/3566683-fix-error-on-status-report.patch"
            },
            "drupal/blog": {
                "Enter drupal/blog patch #3546341 description here":
                "https://www.drupal.org/files/issues/2026-03-07/blog-fix-11-3-x-3546341-4.patch"
            }
        }
    },
    "scripts": {
        "post-install-cmd": [ ],
        "post-update-cmd": [ ],
        "configure-tarball": "Drupal\\wxt\\Composer\\ConfigureLegacyProject::execute",
        "enable-asset-packagist": "Drupal\\wxt\\Composer\\AssetPackagist::execute",
        "nuke": "rm -r -f html vendor",
        "package": "Drupal\\wxt\\Composer\\Package::execute",
        "verify-patched-constraints": "Drupal\\wxt\\Composer\\PatchedConstraint::execute"
    }
}
